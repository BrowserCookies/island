<Window x:Class="Island.Search.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Island.Controls"
        xmlns:s="clr-namespace:Island.Search"
        Title="Island search" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="True"
        Width="712" SizeToContent="Height" Left="-32000" Top="-32000">
    <Window.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource IslandForegroundBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource IslandForegroundBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="12" Background="Transparent" Padding="10,0" Height="48">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type s:SearchResultViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:IconView Icon="{Binding Icon}" IconSize="28" HorizontalAlignment="Left"
                            Foreground="{DynamicResource IslandForegroundBrush}" />
                <Border Width="28" Height="28" CornerRadius="5" HorizontalAlignment="Left"
                        Visibility="{Binding Image, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource IslandForegroundBrush}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SubtleForegroundBrush}"
                               Visibility="{Binding Subtitle, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding KindLabel}" FontSize="11.5" Margin="12,0,4,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- 16 DIP transparent margin so the shadows aren't clipped. -->
    <StackPanel x:Name="Root" Margin="16" RenderTransformOrigin="0.5,0">
        <StackPanel.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </StackPanel.RenderTransform>

        <!-- The pill -->
        <Border Height="56" CornerRadius="28" Padding="20,0,22,0"
                Background="{DynamicResource IslandBackgroundBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Direction="270" Color="{DynamicResource ShadowColorBrushColor}" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center"
                           Margin="0,0,14,0" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Grid.Column="1" x:Name="Placeholder" Text="Search apps, files, songs… or type a sum"
                           FontSize="20" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <TextBox Grid.Column="1" x:Name="QueryBox" Style="{StaticResource SearchBox}"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="QueryBox_PreviewKeyDown" TextChanged="QueryBox_TextChanged" />
            </Grid>
        </Border>

        <!-- Results -->
        <Border Margin="0,10,0,0" CornerRadius="22" Padding="8"
                Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Direction="270" Color="{DynamicResource ShadowColorBrushColor}" />
            </Border.Effect>
            <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" SelectedIndex="{Binding SelectedIndex}"
                     ItemContainerStyle="{StaticResource ResultItem}" Background="Transparent" BorderThickness="0"
                     Focusable="False" MaxHeight="384" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="ResultsList_Click" />
        </Border>
    </StackPanel>
</Window>
