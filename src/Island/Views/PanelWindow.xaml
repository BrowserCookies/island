<Window x:Class="Island.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Island.Controls"
        xmlns:vm="clr-namespace:Island.ViewModels"
        Title="Island menu" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        SizeToContent="WidthAndHeight" Left="-32000" Top="-32000" Focusable="False">
    <Window.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:ColorBrushConverter x:Key="ColorBrush" />

        <ItemsPanelTemplate x:Key="RowPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ColumnPanel">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="GridPanel">
            <UniformGrid Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=Window}}" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="LevelsVertical">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="LevelsHorizontal">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource IslandForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{DynamicResource TileBackgroundBrush}" Padding="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TilePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:TileViewModel}">
            <Button Style="{StaticResource TileButton}" Margin="3" Click="Tile_Click"
                    MouseEnter="Tile_MouseEnter" MouseLeave="Tile_MouseLeave">
                <StackPanel Width="{Binding TileSize}">
                    <Grid Height="{Binding TileSize}">
                        <Border CornerRadius="10" Background="{Binding Item.Icon.Background, Converter={StaticResource ColorBrush}}" />
                        <c:IconView Icon="{Binding Item.Icon}" IconSize="{Binding IconSize}"
                                    Foreground="{DynamicResource IslandForegroundBrush}">
                            <c:IconView.Style>
                                <Style TargetType="c:IconView">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </c:IconView.Style>
                        </c:IconView>
                        <c:Spinner Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                   Width="20" Height="20" />
                        <!-- group indicator -->
                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="8" Opacity="0.7"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                                   Foreground="{DynamicResource IslandForegroundBrush}"
                                   Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}" />
                        <!-- open group indicator -->
                        <Border Height="3" Width="14" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                Background="{DynamicResource AccentBrush}"
                                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <TextBlock Text="{Binding Item.Label}" FontSize="10.5" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="2,0,2,4" Foreground="{DynamicResource IslandForegroundBrush}"
                               Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="TilesHost" TargetType="ItemsControl">
            <Setter Property="ItemsPanel" Value="{StaticResource RowPanel}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Layout, RelativeSource={RelativeSource AncestorType=Window}}" Value="Column">
                    <Setter Property="ItemsPanel" Value="{StaticResource ColumnPanel}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.Layout, RelativeSource={RelativeSource AncestorType=Window}}" Value="Grid">
                    <Setter Property="ItemsPanel" Value="{StaticResource GridPanel}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:PanelLevel}">
            <Border Padding="3" Margin="2" CornerRadius="10" x:Name="LevelBorder">
                <ItemsControl ItemsSource="{Binding Tiles}" Style="{StaticResource TilesHost}" />
            </Border>
            <DataTemplate.Triggers>
                <!-- Opened groups get a subtle backdrop to read as a sub-panel. -->
                <DataTrigger Binding="{Binding Group, Converter={StaticResource BoolToVis}}" Value="Visible">
                    <Setter TargetName="LevelBorder" Property="Background" Value="{DynamicResource TileBackgroundBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Margin="12" CornerRadius="16" Padding="6"
            Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1"
            RenderTransformOrigin="1,1">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Direction="270" Color="{DynamicResource ShadowColorBrushColor}" />
        </Border.Effect>
        <DockPanel>
            <TextBlock x:Name="CaptionText" DockPanel.Dock="Top" Text="{Binding Caption}" Height="20" Padding="6,2,6,0" Margin="0,0,0,2"
                       FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubtleForegroundBrush}"
                       Width="{Binding ActualWidth, ElementName=LevelsHost}" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <ItemsControl x:Name="LevelsHost" ItemsSource="{Binding DisplayLevels}" HorizontalAlignment="Left" VerticalAlignment="Top">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemsPanel" Value="{StaticResource LevelsVertical}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StackLevelsHorizontally}" Value="True">
                                <Setter Property="ItemsPanel" Value="{StaticResource LevelsHorizontal}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
