<Window x:Class="Island.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Island.Controls"
        xmlns:v="clr-namespace:Island.Views"
        xmlns:vm="clr-namespace:Island.ViewModels"
        xmlns:m="clr-namespace:Island.Core.Models;assembly=Island.Core"
        Title="Island settings" Width="1060" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="/Assets/island.ico"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <c:EnumEqualsConverter x:Key="EnumEq" />
        <c:EnumToVisibilityConverter x:Key="EnumVis" />
        <c:ColorBrushConverter x:Key="ColorBrush" />
        <c:ActionTypeNameConverter x:Key="ActionName" />
        <c:PercentConverter x:Key="Percent" />

        <Style x:Key="Field" TargetType="TextBlock" BasedOn="{StaticResource LabelText}" />

        <!-- A text box with a "Browse…" button. Tag on the button names the property to fill. -->
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Content" Value="Browse…" />
        </Style>

        <!-- ============================================== action editors -->
        <DataTemplate DataType="{x:Type m:LaunchAppAction}">
            <StackPanel>
                <TextBlock Style="{StaticResource Field}" Text="App, shortcut or file" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Click="BrowseApp_Click" Tag="Path" />
                    <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Style="{StaticResource HintText}" Text="An .exe, .lnk or any file. Bare names like notepad or code are found via PATH. %ENV% variables work." />
                <TextBlock Style="{StaticResource Field}" Text="Arguments" />
                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Field}" Text="Working directory (optional)" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Click="BrowseFolder_Click" Tag="WorkingDirectory" />
                    <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <CheckBox Content="Run as administrator" IsChecked="{Binding RunAsAdmin}" Margin="0,12,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:OpenFolderAction}">
            <StackPanel>
                <TextBlock Style="{StaticResource Field}" Text="Folder" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Click="BrowseFolder_Click" Tag="Path" />
                    <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:OpenFileAction}">
            <StackPanel>
                <TextBlock Style="{StaticResource Field}" Text="File (opens with its default app)" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Click="BrowseFile_Click" Tag="Path" />
                    <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:OpenUrlAction}">
            <StackPanel>
                <TextBlock Style="{StaticResource Field}" Text="URL (optional)" />
                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource HintText}" Text="Leave empty to open your default browser's home page. Other schemes like mailto: or ms-settings: work too." />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:GroupAction}">
            <StackPanel>
                <TextBlock Style="{StaticResource HintText}" FontSize="12.5" Margin="0,12,0,0"
                           Text="A group opens a sub-panel with its own buttons. Drag buttons onto the group in the list on the left (or select the group and use Add) to fill it." />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:ClaudeCodeHereAction}">
            <StackPanel>
                <TextBlock Style="{StaticResource HintText}" FontSize="12.5" Margin="0,10,0,0"
                           Text="Opens Windows Terminal in the folder of the File Explorer window you were just using (or the fallback folder) and runs the command." />
                <TextBlock Style="{StaticResource Field}" Text="Command" />
                <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource HintText}" Text="Empty = the default from the General tab (claude). Make variants like: claude --continue" />
                <TextBlock Style="{StaticResource Field}" Text="Fallback folder" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Click="BrowseFolder_Click" Tag="FallbackFolder" />
                    <TextBox Text="{Binding FallbackFolder, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Style="{StaticResource HintText}" Text="Used when the last active window isn't Explorer (or shows a special folder like This PC). Empty = the General tab default." />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:ScreenshotAction}">
            <StackPanel>
                <TextBlock Style="{StaticResource Field}" Text="Mode" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Snip (Snipping Tool)" IsChecked="{Binding Mode, Converter={StaticResource EnumEq}, ConverterParameter=Snip}" />
                    <RadioButton Content="Full screen" IsChecked="{Binding Mode, Converter={StaticResource EnumEq}, ConverterParameter=FullScreen}" />
                    <RadioButton Content="Active window" IsChecked="{Binding Mode, Converter={StaticResource EnumEq}, ConverterParameter=ActiveWindow}" />
                </StackPanel>
                <StackPanel Visibility="{Binding Mode, Converter={StaticResource EnumVis}, ConverterParameter='FullScreen,ActiveWindow'}">
                    <TextBlock Style="{StaticResource Field}" Text="Save folder" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Click="BrowseFolder_Click" Tag="SaveFolder" />
                        <TextBox Text="{Binding SaveFolder, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource HintText}" Text="Empty = the screenshot folder from the General tab. Files are named with a timestamp." />
                    <CheckBox Content="Also copy to the clipboard" IsChecked="{Binding CopyToClipboard}" Margin="0,12,0,0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:OpenSettingsAction}">
            <TextBlock Style="{StaticResource HintText}" FontSize="12.5" Margin="0,12,0,0" Text="Opens this settings window." />
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:RunScriptAction}">
            <StackPanel>
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="10,6" Margin="0,10,0,0"
                        Visibility="{Binding Disabled, Converter={StaticResource BoolToVis}}">
                    <CheckBox Content="Disabled — this script came from an imported config. Untick to allow it to run."
                              IsChecked="{Binding Disabled}" Margin="0" />
                </Border>

                <TextBlock Style="{StaticResource Field}" Text="Script source" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Inline script" IsChecked="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter=Inline}" />
                    <RadioButton Content="Script file" IsChecked="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter=File}" />
                </StackPanel>

                <StackPanel Visibility="{Binding Source, Converter={StaticResource EnumVis}, ConverterParameter=File}">
                    <TextBlock Style="{StaticResource Field}" Text="Script file" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Click="BrowseScript_Click" Tag="ScriptPath" />
                        <TextBox Text="{Binding ScriptPath, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding Source, Converter={StaticResource EnumVis}, ConverterParameter=Inline}">
                    <DockPanel Margin="0,10,0,4">
                        <TextBlock Text="Language" VerticalAlignment="Center" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="12" />
                        <ComboBox Width="90" Margin="10,0,0,0" ItemsSource="{x:Static vm:SettingsViewModel.ScriptLanguages}"
                                  SelectedItem="{Binding InlineExtension}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}" Content="Open scripts folder"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenScriptsFolder_Click" />
                    </DockPanel>
                    <TextBox Style="{StaticResource CodeTextBox}" Height="200"
                             Text="{Binding InlineScript, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource HintText}" Text="Saved as %APPDATA%\Island\scripts\&lt;button id&gt;&lt;extension&gt;." />
                </StackPanel>

                <TextBlock Style="{StaticResource Field}" Text="Interpreter" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Automatic (by extension)" IsChecked="{Binding Interpreter, Converter={StaticResource EnumEq}, ConverterParameter=Auto}" />
                    <RadioButton Content="Custom" IsChecked="{Binding Interpreter, Converter={StaticResource EnumEq}, ConverterParameter=Custom}" />
                </StackPanel>
                <TextBlock Style="{StaticResource HintText}" Visibility="{Binding Interpreter, Converter={StaticResource EnumVis}, ConverterParameter=Auto}"
                           Text=".ps1 → PowerShell · .py → Python · .js/.mjs → Node · .bat/.cmd → cmd · .exe → runs directly" />
                <Grid Visibility="{Binding Interpreter, Converter={StaticResource EnumVis}, ConverterParameter=Custom}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Field}" Text="Interpreter executable" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Click="BrowseExe_Click" Tag="CustomInterpreterPath" />
                            <TextBox Text="{Binding CustomInterpreterPath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Field}" Text="Argument template" />
                        <TextBox Text="{Binding CustomArgumentTemplate, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource Field}" Text="Arguments" />
                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="Placeholders: {currentFolder} {clipboard} {date} {time} {islandDir}. Quote them if they may contain spaces, e.g. &quot;{currentFolder}&quot;." />

                <TextBlock Style="{StaticResource Field}" Text="Working directory (optional, placeholders allowed)" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Click="BrowseFolder_Click" Tag="WorkingDirectory" />
                    <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Field}" Text="Output handling" />
                        <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.OutputModes}" SelectedItem="{Binding Output}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Field}" Text="Timeout (s, 0 = none)" />
                        <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource HintText}"
                           Text="Toast shows the last line printed. JsonProtocol reads the last line as JSON: notify, clipboard, openUrl, openPath, popup, error." />
                <CheckBox Content="Show console window (output is then not captured)" IsChecked="{Binding ShowConsole}" Margin="0,12,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- ============================================== preview tiles -->
        <ItemsPanelTemplate x:Key="PreviewRow">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PreviewColumn">
            <WrapPanel Orientation="Vertical" MaxHeight="130" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PreviewGrid">
            <UniformGrid Columns="{Binding DataContext.Working.General.GridColumns, RelativeSource={RelativeSource AncestorType=Window}}" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Padding="0">
            <!-- ======================================================== BUTTONS -->
            <TabItem Header="Buttons">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" MinWidth="230" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- left: tree -->
                    <DockPanel Margin="12,10,4,8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="AddButton" Click="AddButton_Click" Padding="10,4" ToolTip="Add a button below the selection">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Add" Margin="6,0,4,0" />
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8C8;" ToolTip="Duplicate (Ctrl+D)" Command="{Binding DuplicateCommand}" Margin="6,0,0,0" />
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" ToolTip="Delete (Del)" Command="{Binding DeleteCommand}" />
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE70E;" ToolTip="Move up (Alt+↑)" Command="{Binding MoveUpCommand}" />
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE70D;" ToolTip="Move down (Alt+↓)" Command="{Binding MoveDownCommand}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="2,6,0,0"
                                   Text="Drag to reorder or into groups. Drop .exe, .lnk, folders, scripts or .url files from Explorer to add them." />
                        <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6"
                                Background="{DynamicResource SurfaceBrush}">
                            <TreeView x:Name="Tree" ItemsSource="{Binding Working.Buttons}" AllowDrop="True" Padding="4"
                                      SelectedItemChanged="Tree_SelectedItemChanged"
                                      PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="Tree_PreviewMouseMove"
                                      DragEnter="Tree_DragOver" DragOver="Tree_DragOver" DragLeave="Tree_DragLeave" Drop="Tree_Drop"
                                      PreviewKeyDown="Tree_PreviewKeyDown">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                        <Setter Property="Padding" Value="4,1" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type m:ButtonItem}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,3" Background="Transparent">
                                            <Grid Width="24" Height="24">
                                                <Border CornerRadius="5" Background="{Binding Icon.Background, Converter={StaticResource ColorBrush}}" />
                                                <c:IconView Icon="{Binding Icon}" IconSize="18" Foreground="{DynamicResource ForegroundBrush}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"
                                                       ToolTip="{Binding Warning}" Visibility="{Binding Warning, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

                    <!-- right: editor -->
                    <TextBlock Grid.Column="2" Text="Select a button on the left, or add a new one."
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SubtleForegroundBrush}"
                               Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}" />
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="16,10,22,24" MaxWidth="720" HorizontalAlignment="Stretch">
                            <!-- header: icon + test -->
                            <DockPanel>
                                <Grid Width="64" Height="64" DockPanel.Dock="Left">
                                    <Border CornerRadius="12" Background="{DynamicResource ControlBackgroundBrush}"
                                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" />
                                    <Border CornerRadius="12" Background="{Binding Selected.Icon.Background, Converter={StaticResource ColorBrush}}" />
                                    <c:IconView Icon="{Binding Selected.Icon}" IconSize="34" Foreground="{DynamicResource ForegroundBrush}" />
                                </Grid>
                                <StackPanel DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <Button Content="Change icon…" Click="ChangeIcon_Click" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource HintText}" Text="Glyph, app icon, image file or emoji" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" Command="{Binding TestCommand}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Run this action now (unsaved changes included)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                        <TextBlock Text="Test" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>

                            <!-- validation -->
                            <ItemsControl ItemsSource="{Binding SelectedErrors}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource WarningBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Field}" Text="Label" />
                                    <TextBox x:Name="LabelBox" Text="{Binding Selected.Label, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Field}" Text="Tooltip (optional)" />
                                    <TextBox Text="{Binding Selected.Tooltip, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Field}" Text="Icon tint (optional, #RRGGBB)" />
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Width="30" Height="30" CornerRadius="5" Margin="6,0,0,0"
                                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                                Background="{Binding Selected.Icon.TintColor, Converter={StaticResource ColorBrush}}" />
                                        <TextBox Text="{Binding Selected.Icon.TintColor, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Field}" Text="Button background (optional, #RRGGBB)" />
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Width="30" Height="30" CornerRadius="5" Margin="6,0,0,0"
                                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                                Background="{Binding Selected.Icon.Background, Converter={StaticResource ColorBrush}}" />
                                        <TextBox Text="{Binding Selected.Icon.Background, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    </DockPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="Action" />
                            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.ActionTypes}" SelectedItem="{Binding SelectedActionType}"
                                      Width="260" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ActionName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ContentControl Content="{Binding Selected.Action}" Focusable="False" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- preview -->
                    <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0"
                            Padding="12,8,12,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Preview" Foreground="{DynamicResource SubtleForegroundBrush}"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="14" Padding="5"
                                        BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                    <ItemsControl ItemsSource="{Binding Working.Buttons}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="ItemsPanel" Value="{StaticResource PreviewRow}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Working.General.Layout}" Value="Column">
                                                        <Setter Property="ItemsPanel" Value="{StaticResource PreviewColumn}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Working.General.Layout}" Value="Grid">
                                                        <Setter Property="ItemsPanel" Value="{StaticResource PreviewGrid}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:ButtonItem}">
                                                <StackPanel Margin="3" Width="44" ToolTip="{Binding DisplayTooltip}">
                                                    <Grid Height="44">
                                                        <Border CornerRadius="10" Background="{DynamicResource TileBackgroundBrush}" />
                                                        <Border CornerRadius="10" Background="{Binding Icon.Background, Converter={StaticResource ColorBrush}}" />
                                                        <c:IconView Icon="{Binding Icon}" IconSize="23" Foreground="{DynamicResource IslandForegroundBrush}" />
                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" HorizontalAlignment="Right"
                                                                 VerticalAlignment="Top" Margin="3" Visibility="{Binding Warning, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Label}" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource IslandForegroundBrush}"
                                                               Visibility="{Binding DataContext.Working.General.ShowLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================================================== GENERAL -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,6,24,24" MaxWidth="680" HorizontalAlignment="Left" Width="680">

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Startup &amp; hotkey" />
                        <CheckBox Content="Start Island with Windows" IsChecked="{Binding Working.General.StartWithWindows}" />
                        <TextBlock Style="{StaticResource Field}" Text="Global hotkey (click the box and press a key combination)" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Clear" Margin="6,0,0,0" Click="ClearHotkey_Click" />
                            <TextBox x:Name="HotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"
                                     Text="{Binding Working.General.Hotkey, Mode=OneWay, TargetNullValue='(none)'}"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus" />
                        </DockPanel>
                        <TextBlock Text="{Binding HotkeyStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HotkeyStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Field}" Text="The hotkey…" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Expands / collapses the island" IsChecked="{Binding Working.General.HotkeyAction, Converter={StaticResource EnumEq}, ConverterParameter=ToggleExpand}" />
                            <RadioButton Content="Shows / hides the island" IsChecked="{Binding Working.General.HotkeyAction, Converter={StaticResource EnumEq}, ConverterParameter=ToggleVisibility}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Text="The same hotkey with Shift opens this window." />

                        <TextBlock Style="{StaticResource Field}" Text="Search shortcut (opens the search bar in the middle of the screen)" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Clear" Margin="6,0,0,0" Tag="search" Click="ClearHotkey_Click" />
                            <TextBox x:Name="SearchHotkeyBox" Tag="search" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"
                                     Text="{Binding Working.General.SearchHotkey, Mode=OneWay, TargetNullValue='(none)'}"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus" />
                        </DockPanel>
                        <TextBlock Text="{Binding SearchHotkeyStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchHotkeyStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Island" />
                        <CheckBox Content="Snap to screen corners" IsChecked="{Binding Working.General.SnapEnabled}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Field}">
                                    <Run Text="Size: " /><Run Text="{Binding Working.General.IslandSize, Mode=OneWay}" /><Run Text=" px" />
                                </TextBlock>
                                <Slider Minimum="32" Maximum="120" TickFrequency="2" IsSnapToTickEnabled="True"
                                        Value="{Binding Working.General.IslandSize}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Field}">
                                    <Run Text="Opacity when idle: " /><Run Text="{Binding Working.General.Opacity, Mode=OneWay, Converter={StaticResource Percent}}" />
                                </TextBlock>
                                <Slider Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding Working.General.Opacity}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <StackPanel Width="160">
                                <TextBlock Style="{StaticResource Field}" Text="Snap margin (px)" />
                                <TextBox Text="{Binding Working.General.SnapMargin, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Content="Hover effect" IsChecked="{Binding Working.General.HoverEffect}" Margin="0,12,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Expanded menu" />
                        <TextBlock Style="{StaticResource Field}" Text="Layout" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Row" IsChecked="{Binding Working.General.Layout, Converter={StaticResource EnumEq}, ConverterParameter=Row}" />
                            <RadioButton Content="Column" IsChecked="{Binding Working.General.Layout, Converter={StaticResource EnumEq}, ConverterParameter=Column}" />
                            <RadioButton Content="Grid" IsChecked="{Binding Working.General.Layout, Converter={StaticResource EnumEq}, ConverterParameter=Grid}" />
                            <TextBlock Text="Columns:" VerticalAlignment="Center" Margin="14,0,6,0"
                                       Visibility="{Binding Working.General.Layout, Converter={StaticResource EnumVis}, ConverterParameter=Grid}" />
                            <TextBox Width="50" Text="{Binding Working.General.GridColumns, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding Working.General.Layout, Converter={StaticResource EnumVis}, ConverterParameter=Grid}" />
                        </StackPanel>
                        <CheckBox Content="Show labels under icons" IsChecked="{Binding Working.General.ShowLabels}" Margin="0,12,0,0" />
                        <CheckBox Content="Collapse after an action runs" IsChecked="{Binding Working.General.CollapseAfterAction}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Appearance" />
                        <TextBlock Style="{StaticResource Field}" Text="Theme" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="System" IsChecked="{Binding Working.General.Theme, Converter={StaticResource EnumEq}, ConverterParameter=System}" />
                            <RadioButton Content="Dark" IsChecked="{Binding Working.General.Theme, Converter={StaticResource EnumEq}, ConverterParameter=Dark}" />
                            <RadioButton Content="Light" IsChecked="{Binding Working.General.Theme, Converter={StaticResource EnumEq}, ConverterParameter=Light}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Field}" Text="Accent color (#RRGGBB, empty = Windows accent)" />
                        <DockPanel Width="260" HorizontalAlignment="Left">
                            <Border DockPanel.Dock="Right" Width="30" Height="30" CornerRadius="5" Margin="6,0,0,0"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                    Background="{Binding Working.General.AccentColor, Converter={StaticResource ColorBrush}}" />
                            <TextBox Text="{Binding Working.General.AccentColor, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Defaults for actions" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Field}" Text="Claude Code command" />
                                <TextBox Text="{Binding Working.General.ClaudeCommand, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Field}" Text="Fallback folder" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Click="BrowseGeneralFolder_Click" Tag="FallbackFolder" />
                                    <TextBox Text="{Binding Working.General.FallbackFolder, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Field}" Text="Screenshot folder" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Click="BrowseGeneralFolder_Click" Tag="ScreenshotFolder" />
                            <TextBox Text="{Binding Working.General.ScreenshotFolder, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Field}" Text="PowerShell for .ps1 scripts" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Windows PowerShell (powershell.exe)" IsChecked="{Binding Working.General.PowerShell, Converter={StaticResource EnumEq}, ConverterParameter=WindowsPowerShell}" />
                            <RadioButton Content="PowerShell 7 (pwsh.exe, if installed)" IsChecked="{Binding Working.General.PowerShell, Converter={StaticResource EnumEq}, ConverterParameter=Pwsh}" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Field}" Text="Python command (e.g. python or py -3)" />
                                <TextBox Text="{Binding Working.General.PythonCommand, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Field}" Text="Node command" />
                                <TextBox Text="{Binding Working.General.NodeCommand, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Data" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open data folder" Click="OpenDataFolder_Click" />
                            <Button Content="Edit config.json" Margin="8,0,0,0" Click="OpenConfigFile_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="config.json is watched: hand edits are picked up live. A backup of the previous version is kept as config.backup.json." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================================== SERVICES -->
            <TabItem Header="Services">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,6,24,24" MaxWidth="680" HorizontalAlignment="Left" Width="680">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Spotify" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="Find songs in the search bar and play them with Enter. Needs Spotify Premium. Island signs in through Spotify's own page in your browser and never sees your password." />

                        <TextBlock Style="{StaticResource Field}" Text="One-time setup" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" LineHeight="22">
                            1. Open the Spotify developer dashboard and log in with your Spotify account.<LineBreak />
                            2. Click Create app. Any name and description will do.<LineBreak />
                            3. Under Redirect URIs, add the address below exactly as shown.<LineBreak />
                            4. Under "Which API/SDKs are you planning to use?", tick Web API, then Save.<LineBreak />
                            5. Copy the app's Client ID, paste it below and click Sign in.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Open Spotify dashboard" Click="OpenSpotifyDashboard_Click" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Field}" Text="Redirect URI" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Copy" Margin="6,0,0,0" Click="CopyRedirectUri_Click" />
                            <TextBox IsReadOnly="True" Text="{Binding SpotifyRedirectUri, Mode=OneWay}" Style="{StaticResource CodeTextBox}" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource Field}" Text="Client ID" />
                        <TextBox Text="{Binding Working.Services.Spotify.ClientId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeTextBox}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Sign in" Style="{StaticResource AccentButtonStyle}" Command="{Binding SpotifySignInCommand}"
                                    IsEnabled="{Binding SpotifyCanSignIn}" />
                            <Button Content="Sign out" Margin="8,0,0,0" Command="{Binding SpotifySignOutCommand}"
                                    Visibility="{Binding SpotifySignedIn, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="{Binding SpotifyStatus}" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Text="Your sign-in is stored encrypted for your Windows account in %APPDATA%\Island\secrets, not in config.json, so exporting settings never shares it." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================================== RUN LOG -->
            <TabItem Header="Script runs">
                <v:RunLogView x:Name="RunLog" Margin="16,12,16,12" />
            </TabItem>
        </TabControl>

        <!-- undo snackbar -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,84" CornerRadius="8"
                Padding="14,8,8,8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1" Visibility="{Binding UndoMessage, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.3" Color="{DynamicResource ShadowColorBrushColor}" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding UndoMessage}" VerticalAlignment="Center" />
                <Button Content="Undo" Margin="16,0,0,0" Command="{Binding UndoCommand}" Style="{StaticResource AccentButtonStyle}" Padding="12,3" />
                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE711;" FontSize="10" Command="{Binding DismissUndoCommand}" Margin="4,0,0,0" />
            </StackPanel>
        </Border>

        <!-- bottom bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Import…" Click="Import_Click" />
                <Button DockPanel.Dock="Left" Content="Export…" Margin="8,0,0,0" Click="Export_Click" />
                <Button DockPanel.Dock="Left" Content="Reset to defaults" Margin="8,0,0,0" Click="Reset_Click" />
                <Button DockPanel.Dock="Right" Content="Cancel" MinWidth="90" Margin="8,0,0,0" Click="Cancel_Click"
                        ToolTip="Discard unsaved changes and close" />
                <Button DockPanel.Dock="Right" Content="Save" MinWidth="90" Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding SaveCommand}" ToolTip="Save and apply to the island (Ctrl+S)" />
                <TextBlock DockPanel.Dock="Right" Text="Unsaved changes" VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
