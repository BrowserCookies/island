<Window x:Class="Island.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        SizeToContent="WidthAndHeight" Focusable="False" Title="Island notification">
    <Border x:Name="Root" Margin="12" CornerRadius="10" Padding="14,10,8,10" MinWidth="220" MaxWidth="380"
            Background="{DynamicResource ToastBackgroundBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Color="{DynamicResource ShadowColorBrushColor}" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="KindIcon" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,1,10,0"
                       VerticalAlignment="Top" Foreground="{DynamicResource AccentBrush}" Text="&#xE946;" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,2" />
                <TextBlock x:Name="MessageText" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" />
                <WrapPanel x:Name="ActionsPanel" Margin="0,6,0,0" Visibility="Collapsed" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE711;" FontSize="10"
                    VerticalAlignment="Top" Margin="6,-4,0,0" MinWidth="24" Padding="4" Click="Close_Click" ToolTip="Dismiss" />
        </Grid>
    </Border>
</Window>
